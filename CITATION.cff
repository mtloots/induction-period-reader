    given-names: "M. Theodor"
    orcid: "https://orcid.org/0000-0001-7722-3913"
version: 1.0.0
date-released: "2026-08-27"
license: MIT
repository-code: "https://github.com/mtloots/induction-period-reader"
keywords:
  - Rancimat
  - induction period
  - oxidative stability
  - edible oils
  - four-parameter kappa distribution
  - curve fitting
